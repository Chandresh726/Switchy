{
  "name": "switchy",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "predev": "NODE_ENV=development pnpm db:migrate",
    "dev": "NODE_ENV=development next dev",
    "prestart": "NODE_ENV=production pnpm db:migrate",
    "build": "next build",
    "start": "NODE_ENV=production next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm audit && pnpm build",
    "landing:lint": "pnpm --filter switchy-landing lint",
    "landing:typecheck": "pnpm --filter switchy-landing typecheck",
    "landing:audit": "pnpm --filter switchy-landing audit",
    "landing:build": "pnpm --filter switchy-landing build",
    "landing:verify": "pnpm --filter switchy-landing verify",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:cleanup-job-duplicates": "tsx scripts/cleanup-job-duplicates.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.86",
    "@ai-sdk/cerebras": "^2.0.57",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/groq": "^3.0.42",
    "@ai-sdk/openai": "^3.0.74",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@base-ui/react": "^1.6.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-switch": "^1.3.1",
    "@tanstack/react-query": "^5.101.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.209",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.6.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "node-cron": "^4.5.0",
    "p-queue": "^9.3.0",
    "playwright": "^1.61.1",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/node-cron": "^3.0.11",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
