{
  "name": "switchy",
  "version": "1.0.12",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "predev": "NODE_ENV=development pnpm db:migrate",
    "dev": "NODE_ENV=development SWITCHY_PROCESS_TITLE='Switchy Dev' NODE_OPTIONS=\"$NODE_OPTIONS --require=./scripts/switchy-process-title.cjs\" next dev --hostname 127.0.0.1",
    "prestart": "NODE_ENV=production pnpm db:migrate",
    "build": "node scripts/build-production.mjs",
    "cli:build": "node packages/cli/scripts/build.mjs",
    "cli:typecheck": "tsc --noEmit -p packages/cli/tsconfig.json",
    "distribution:verify": "pnpm cli:typecheck && pnpm cli:build && vitest run --project unit tests/unit/distribution tests/unit/state/layout.test.ts",
    "runtime:package": "node scripts/package-runtime.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "start": "NODE_ENV=production SWITCHY_PROCESS_TITLE=Switchy NODE_OPTIONS=\"$NODE_OPTIONS --require=./scripts/switchy-process-title.cjs\" next start --hostname 127.0.0.1 --port 6767",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "deadcode": "SWITCHY_ANALYSIS=1 knip",
    "test": "node scripts/run-tests.mjs",
    "test:run": "node scripts/run-tests.mjs --run",
    "test:unit": "node scripts/run-tests.mjs --run --project unit",
    "test:integration": "node scripts/run-tests.mjs --run --project integration",
    "test:ui": "node scripts/run-tests.mjs --run --project ui --passWithNoTests",
    "ai:eval": "node scripts/run-tests.mjs --run --project eval",
    "test:coverage": "node scripts/run-tests.mjs --run --coverage",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "verify": "pnpm lint && pnpm typecheck && pnpm deadcode && pnpm test:run && pnpm distribution:verify && pnpm audit:prod && pnpm build",
    "verify:all": "pnpm verify && pnpm landing:verify",
    "landing:lint": "pnpm --filter switchy-landing lint",
    "landing:typecheck": "pnpm --filter switchy-landing typecheck",
    "landing:audit": "pnpm --filter switchy-landing audit",
    "landing:build": "pnpm --filter switchy-landing build",
    "landing:verify": "pnpm --filter switchy-landing verify",
    "video:capture": "pnpm --filter switchy-demo-video capture",
    "video:studio": "pnpm --filter switchy-demo-video studio",
    "video:render": "pnpm --filter switchy-demo-video render",
    "video:verify": "pnpm --filter switchy-demo-video verify",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "ai:cli:smoke": "tsx scripts/ai-cli-smoke.mts",
    "state:backup": "tsx scripts/state-backup.ts",
    "state:backup:verify": "tsx scripts/state-backup-verify.ts",
    "state:restore": "tsx scripts/state-restore.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/cerebras": "^3.0.7",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/groq": "^4.0.8",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@base-ui/react": "^1.6.0",
    "@opencode-ai/sdk": "^1.17.20",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-switch": "^1.3.3",
    "@tanstack/react-query": "^5.101.2",
    "ai": "^7.0.22",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "p-queue": "^9.3.1",
    "playwright": "^1.61.1",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.6",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.4.0",
    "knip": "6.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
